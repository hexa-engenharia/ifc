{
  "name": "HEXA Visualizador IFC",
  "short_name": "HEXA Visualizador",
  "description": "Abra modelos IFC do computador: arraste os arquivos (um, vários ou a pasta do projeto) e veja o 3D. Nada é enviado.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef0f3",
  "theme_color": "#ffffff",
  "lang": "pt-BR",
  "icons": [
    { "src": "icons/icon192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-step": [".ifc"],
        "application/zip": [".ifczip"]
      }
    }
  ]
}
